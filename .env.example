# --- CognoDB connection (never commit real values; copy to .env locally) ---

# Bolt URI of your CognoDB instance, from the CognoDB console
COGNODB_URI=bolt+s://your-instance.cognodb.example.com:7687

# CognoDB username is "cognodb" by default
COGNODB_USERNAME=cognodb

# Instance password shown once at creation time
COGNODB_PASSWORD=replace-me

# --- Runtime behaviour -------------------------------------------------------

# "cognodb" = require CognoDB · "demo" = embedded dataset · "auto" (default) =
# use CognoDB when COGNODB_URI is set, otherwise the embedded demo dataset
GRAPH_BACKEND=auto

# Flask port for the API (frontend dev server proxies /api here)
PORT=8000
